# Neon Postgres. Use the pooled URL for the app and the direct URL for Prisma CLI.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"
NEON_BRANCH="production"

# Neon Object Storage (S3-compatible). `neon deploy` writes these standard AWS
# variables automatically. Do not use Cloudflare R2's S3_* variable names.
AWS_ACCESS_KEY_ID="..."
AWS_SECRET_ACCESS_KEY="..."
AWS_ENDPOINT_URL_S3="https://..."
AWS_REGION="..."
# Optional override. The bucket declared in neon.ts is used by default.
# NEON_STORAGE_BUCKET="assets"

# Generate with: openssl rand -base64 32
# Use a different value in every environment. Minimum 32 characters in production.
NEXTAUTH_SECRET="replace-this-with-a-long-random-secret"

# Tracked certificate quota used for upload preflight checks.
# Defaults to 9000 MB for Neon object storage and 900 MB for local disk.
# CERTIFICATE_STORAGE_LIMIT_MB="9000"

# Optional seed overrides.
# SEED_ADMIN_EMAIL="admin@ktu.edu"
# SEED_ADMIN_PASSWORD="choose-a-strong-password"
# SEED_ADMIN_NAME="Dr. Suresh V. (Senior Faculty Advisor)"
# SEED_DEMO_STUDENT="false"
# Set to true to reset the password of already-seeded accounts:
# SEED_RESET_PASSWORDS="true"
